# API Configuration
# The base URL of the backend API.
# During local development, this is typically http://localhost:5000/api
# In production, set this to your deployed backend URL.
VITE_API_URL=http://localhost:5000/api

# Supabase Configuration
# Your Supabase Project URL (Same as backend SUPABASE_URL)
VITE_SUPABASE_URL=

# Your Supabase Anon Key (Public Key)
VITE_SUPABASE_ANON_KEY=
