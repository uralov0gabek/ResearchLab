# Database Configuration
# The URL of your Supabase project (e.g., https://xyzcompany.supabase.co)
SUPABASE_URL=

# The Service Role Key for Supabase. 
# WARNING: Keep this secret! It bypasses Row Level Security (RLS).
SUPABASE_SERVICE_ROLE_KEY=

# The JWT Secret used to sign and verify tokens for Admin access.
# Must match the JWT secret in your Supabase project settings.
SUPABASE_JWT_SECRET=

# Server Configuration
# The port the Express server will listen on. Defaults to 5000.
PORT=5000

# CORS Configuration
# The URL of the frontend application allowed to make requests to this backend.
# Example: http://localhost:5173 for local development.
FRONTEND_URL=http://localhost:5173
