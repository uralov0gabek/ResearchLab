# ==============================================================
# Backend Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit the .env file to version control.
# ==============================================================

# --- Supabase ---
# Your Supabase project URL
SUPABASE_URL=https://your-project-id.supabase.co

# The Service Role Key — has admin access, bypasses RLS.
# WARNING: Keep this secret. Never expose it to the frontend.
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# JWT Secret for verifying admin tokens.
# Found in: Supabase Dashboard > Project Settings > API > JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# --- Server ---
PORT=5000
NODE_ENV=development

# --- CORS ---
# URL of the frontend allowed to connect to this backend.
# Local development: http://localhost:5173
# Production: https://your-app.vercel.app
FRONTEND_URL=http://localhost:5173
